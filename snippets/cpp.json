  "Check Prime": {
    "prefix": "f_isprime",
    "body": [
      "bool isPrime(int n) {",
      "\tfor (int i = 2; i * i <= n; i++)",
      "\t\tif (n % i == 0)",
      "\t\t\treturn false;",
      "",
      "\treturn n >= 2;",
      "}"
    ],
    "description": "Hàm kiểm tra số nguyên tố (O(sqrt(N)))"
  },
  "Check Prime Digits": {
    "prefix": "f_isprimedigit",
    "body": [
      "bool isPrimeDigit(int n) {",
      "\tfor (; n; n /= 10)",
      "\t\tif (!isPrime(n % 10))",
      "\t\t\treturn false;",
      "",
      "\treturn true;",
      "}"
    ],
    "description": "Hàm kiểm tra tất cả các chữ số có phải là số nguyên tố"
  },
  "Check Total Prime Digits": {
    "prefix": "f_istotalprimedigit",
    "body": [
      "bool isTotalPrimeDigit(int n) {",
      "\tint s = 0;",
      "\tfor (; n; n /= 10) {",
      "\t\tint digit = n % 10;",
      "\t\ts += digit;",
      "\t\tif (!isPrime(digit))",
      "\t\t\treturn false;",
      "\t}",
      "",
      "\treturn isPrime(s);",
      "}"
    ],
    "description": "Hàm kiểm tra các chữ số là số NT và tổng chữ số cũng là số NT"
  },
